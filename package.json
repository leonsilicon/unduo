{
  "name": "unduo",
  "version": "1.1.0",
  "description": "Un-Duo yourself by making it possible to use any 2FA application for Duo Security authentication.",
  "keywords": [
    "2fa",
    "authenticator",
    "cli",
    "duo",
    "duo-security",
    "hotp",
    "otp",
    "totp"
  ],
  "homepage": "https://github.com/leonsilicon/unduo#readme",
  "bugs": {
    "url": "https://github.com/leonsilicon/unduo/issues"
  },
  "license": "MIT",
  "author": "Leon Si",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonsilicon/unduo.git"
  },
  "bin": {
    "unduo": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "start": "bun ./src/cli.ts",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@scure/base": "^2.2.0",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "debug": "^4.4.3",
    "destr": "^2.0.5",
    "env-paths": "^4.0.0",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "tinyclip": "^0.1.15",
    "unstorage": "^1.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "^0.2.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
